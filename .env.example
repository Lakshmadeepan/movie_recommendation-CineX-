# ===================================================
# CINEX ENVIRONMENT CONFIGURATION
# ===================================================

# Frontend: TMDB API Key (Get your free key from https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Frontend: Backend API Base URL (Optional - leave blank when running locally with Vite proxy)
# For production deployment (e.g. Render / Railway / Heroku):
# VITE_API_URL=https://your-backend-api.onrender.com

# Backend: Environment Variables (for backend/.env or hosting provider)
# TMDB_API_KEY=your_tmdb_api_key_here
# CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://your-app.netlify.app
